{
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*", "http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "shell:allow-open",
    "process:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "http:default",
    "opener:default",
    "updater:default"
  ]
}

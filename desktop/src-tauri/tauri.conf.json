{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Kanva",
  "version": "0.1.0",
  "identifier": "fr.nytuo.kanva",
  "build": {
    "beforeBuildCommand": "npm run --prefix ../web build",
    "beforeDevCommand": "npm run --prefix ../web dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "Kanva",
        "width": 1200,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright 2026 Kanva",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "createUpdaterArtifacts": true,
    "longDescription": "A full-featured Kanban board management application with calendar planner and integrations.",
    "shortDescription": "Kanban Board Management",
    "linux": {
      "deb": { "depends": [] }
    },
    "macOS": {
      "entitlements": null,
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEODAzQkVEMDAyMDVEQjUKUldTMVhTQUE3VHVBZlozT1didVRuNnVSZ1MwRzc4N3NjbUhvalZqQlZjdGFZNytFbkdZeXdqN0QK",
      "endpoints": [
        "https://github.com/Nytuo/Kanva/releases/latest/download/latest.json"
      ]
    }
  }
}

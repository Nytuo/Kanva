{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Kanva",
  "version": "0.1.0",
  "identifier": "fr.nytuo.kanva",
  "build": {
    "beforeBuildCommand": "npm run --prefix ../web build",
    "beforeDevCommand": "npm run --prefix ../web dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright 2026 Kanva",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "A full-featured Kanban board management application with calendar planner and integrations.",
    "shortDescription": "Kanban Board Management",
    "iOS": {
      "developmentTeam": ""
    },
    "android": {}
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
